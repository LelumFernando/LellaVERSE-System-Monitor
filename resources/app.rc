#include <windows.h>

#define IDI_APP_ICON 101

// Custom Application Icon
IDI_APP_ICON ICON "resources/app.ico"

// Embedded Administrator Manifest
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "resources/app.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "LellaVERSE"
            VALUE "FileDescription",  "LellaVERSE System Monitor (Universal Edition)"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "LellaVERSE_System_Monitor"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Lelum Anuradha Fernando / LellaVERSE"
            VALUE "OriginalFilename", "LellaVERSE_System_Monitor.exe"
            VALUE "ProductName",      "LellaVERSE System Monitor"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
